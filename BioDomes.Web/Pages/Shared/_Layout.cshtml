@using BioDomes.Infrastructures.Models
@using BioDomes.Web.Extensions
@using Microsoft.AspNetCore.Identity
@inject SignInManager<UserEntity> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - BioDomes</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/bundle.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/BioDomes.Web.styles.css" asp-append-version="true"/>
    <link rel="icon" href="~/favicon.ico">
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white box-shadow">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">BioDomes : Terrarium Zero</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark @Html.IsActive("/Biomes")" asp-area="" asp-page="/Biomes/Index">Biomes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark @Html.IsActive("/Species")" asp-area="" asp-page="/Species/Index">Especes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark @Html.IsActive("/Equipments")" asp-area=""
                           asp-page="/Equipments/Index">Equipements</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark @Html.IsActive("/FoodChain")" asp-area=""
                           asp-page="/FoodChain/Index">Chaine alimentaire</a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-darl @Html.IsActive("/Stats")" asp-area=""
                               asp-page="/Stats/Index">Statistiques</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark @Html.IsActive("/Account")" asp-area=""
                               asp-page="/Account/Index">@User.Identity!.Name</a>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                                <button type="submit" class="nav-link btn btn-link text-dark">Se déconnecter</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark @Html.IsActive("/Account/Login")" asp-area="Identity"
                               asp-page="/Account/Login">Connexion</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @Html.IsActive("/Account/Register")" asp-area="Identity"
                               asp-page="/Account/Register">Inscription</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main">
    <partial name="_Notification"/>
    @RenderBody()
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>