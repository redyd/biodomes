@model BioDomes.Web.Pages.Biomes.Detail

@{
    var equipments = Model.Biome.Model.Equipments;
}

<aside class="sidebar-info p-4">
    <div class="mb-5">
        <span class="text-uppercase text-muted small fw-bold">Gestions</span>
        <h2 class="text-bright mt-2 mb-1" id="title">Espèces & équipements</h2>
    </div>

    <section class="mb-5">
        <div class="d-flex align-items-center mb-3">
            <div class="point point-primary"></div>
            <h6 class="text-bright m-0" id="existing-title">Les espèces</h6>
            @if (Model.Analyze.Graph.Nodes.Count > 0 && Model.Biome.CanEdit)
            {
                <button
                    class="btn-action btn-add"
                    title="Ajouter une nouvelle espèce"
                    onclick="document.getElementById('add-species-dialog').showModal()">
                    +
                </button>
            }
        </div>
        <ul class="list-unstyled d-flex flex-column gap-2">
            @foreach (var chainNode in Model.Analyze.Graph.Nodes)
            {
                <li class="li-info-card">
                    <div class="d-flex flex-column">
                        <span>@chainNode.Specie.Name (@chainNode.Count)</span>
                        <span class="li-card-meta">@chainNode.Specie.Classification.Label</span>
                    </div>
                    @if (Model.Biome.CanEdit)
                    {
                        <button
                            class="btn-action btn-remove"
                            title="Supprimer des @chainNode.Specie.Name"
                            data-specie-id="@chainNode.Specie"
                            data-specie-name="@chainNode.Specie.Name"
                            data-specie-count="@chainNode.Count"
                            onclick="openRemoveSpecieDialog(this)">
                            ×
                        </button>
                    }
                </li>
            }
            @if (Model.Analyze.Graph.Nodes.Count == 0)
            {
                <li class="li-info-card">
                    <div class="d-flex flex-column">
                        <span>Commencez à ajouter des espèces</span>
                        <span class="li-card-meta">Aucune espèce</span>
                    </div>
                    <button
                        class="btn-action btn-add"
                        title="Ajouter votre première espèce"
                        onclick="document.getElementById('add-species-dialog').showModal()">
                        +
                    </button>
                </li>
            }
        </ul>
    </section>

    <section>
        <div class="d-flex align-items-center mb-3">
            <div class="point point-secondary"></div>
            <h6 class="text-bright m-0" id="available-title">Les équipements</h6>
            @if (equipments.Count > 0 && Model.Biome.CanEdit)
            {
                <button
                    class="btn-action btn-add"
                    title="Ajouter un nouvel équipement"
                    onclick="document.getElementById('add-equipment-dialog').showModal()">
                    +
                </button>
            }
        </div>
        <ul class="list-unstyled d-flex flex-column gap-2">
            @foreach (var equipment in equipments)
            {
                <li class="li-info-card">
                    <div class="d-flex flex-column">
                        <span>@equipment.Model.Name (@equipment.TrackedInsertionsById.Count)</span>
                        <span class="li-card-meta">Produit: @equipment.Model.Produced.Label</span>
                        <span class="li-card-meta">Consomme: @equipment.Model.Consumed.Label</span>
                    </div>
                    @if (Model.Biome.CanEdit)
                    {
                        <button
                            class="btn-action btn-remove"
                            title="Supprimer des @equipment.Model.Name"
                            data-equipment-id="@equipment.Model.Slug"
                            data-equipment-name="@equipment.Model.Name"
                            data-equipment-count="@equipment.TrackedInsertionsById.Count"
                            onclick="openRemoveEquipmentDialog(this)">
                            ×
                        </button>
                    }
                </li>
            }
            @if (equipments.Count == 0)
            {
                <li class="li-info-card">
                    <div class="d-flex flex-column">
                        <span>Commencez à ajouter des équipements</span>
                        <span class="li-card-meta">Aucun équipement</span>
                    </div>
                    <button
                        class="btn-action btn-add p-2"
                        title="Ajouter votre premier équipement"
                        onclick="document.getElementById('add-equipment-dialog').showModal()">
                        +
                    </button>
                </li>
            }
        </ul>
    </section>
</aside>