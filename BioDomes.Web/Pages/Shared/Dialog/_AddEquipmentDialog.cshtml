@model BioDomes.Web.Pages.Biomes.Detail

<dialog id="add-equipment-dialog">
    <div class="large-edit-card">
        <div class="edit-header">
            <p class="edit-breadcrumb">Biodômes · @Model.Biome.Model.Name</p>
            <h1 class="edit-title">Ajouter un équipement</h1>
        </div>

        <form method="post" asp-page-handler="AddEquipment" class="edit-body">

            <div class="field-group">
                <div class="suggestion-group">
                    @foreach (var equipment in Model.AllEquipments)
                    {
                        <label class="suggestion-card">
                            <input type="radio" asp-for="EquipmentInput.EquipmentSlug" value="@equipment.Slug" hidden/>
                            <img class="suggestion-card-img"
                                 src="@equipment.Image"
                                 alt="@equipment.Name"/>
                            <span class="suggestion-name">@equipment.Name</span>
                        </label>
                    }
                </div>
                <span asp-validation-for="EquipmentInput.EquipmentSlug" class="field-error"></span>
            </div>

            <div class="field-group">
                <label class="field-label">Quantité</label>
                <input class="field-input" type="number" step="1" min="1" asp-for="EquipmentInput.Count"/>
                <span asp-validation-for="EquipmentInput.Count" class="field-error"></span>
            </div>

            <div class="edit-divider"></div>

            <div class="edit-actions">
                <button type="button" class="btn-cancel"
                        onclick="document.getElementById('add-equipment-dialog').close()">
                    Annuler
                </button>
                <button class="btn-save" type="submit">Ajouter</button>
            </div>

        </form>
    </div>
</dialog>

@if (Model.ReopenAddEquipmentDialog)
{
    <script>
        document.getElementById('add-equipment-dialog').showModal();
    </script>
}