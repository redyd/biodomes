@using BioDomes.Web.Extensions
@using BioDomes.Web.InputModel
@using BioDomes.Web.PageModels

@{
    var notification = TempData.ConsumeNotification();
    var classType = notification?.Type switch
    {
        NotificationType.Success => "success",
        NotificationType.Error => "error",
        _ => "success"
    };
}

@if (notification is not null)
{
    <div class="@classType-banner" id="notification-banner">
        @notification.Message.Sanitize()
    </div>

    <script>
        const el = document.getElementById('notification-banner');
        if (el) {
            requestAnimationFrame(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateX(0)';
            });

            setTimeout(() => {
                el.style.opacity = '0';
                el.style.transform = 'translateX(2rem)';
                setTimeout(() => el.remove(), 300);
            }, 4000);
        }
    </script>
}