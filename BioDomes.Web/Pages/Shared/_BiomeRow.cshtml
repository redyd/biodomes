@using BioDomes.Web.Extensions
@model BioDomes.Web.ViewModels.BiomeView<BioDomes.Domains.Core.ComplexBiome>

<div class="biome-row-wrap" data-slug="@Model.Model.Slug">
    <div class="biome-row">
        <div class="biome-row-image">
            <img src="@Model.ImageUrl" alt="@Model.Model.Name"/>
            <span class="biome-state biome-state-badge biome-state-@Model.Model.State.GetDisplayName().ToLower()">
                @Model.Model.State.GetDisplayName()
            </span>
        </div>

        <a class="biome-row-body" asp-page="/Biomes/Detail" asp-route-slug="@Model.Model.Slug">
            <div class="biome-row-header">
                <h2 class="biome-row-name">@Model.Model.Name.Sanitize()</h2>
                @if (Model.IsPublic)
                {
                    <span class="biome-badge-public">public</span>
                }
            </div>
            <div class="biome-row-stats">
                <div class="biome-stat">
                    <span class="biome-stat-label">Température</span>
                    <span class="biome-stat-value">@Model.Model.Temperature °C</span>
                </div>
                <div class="biome-stat">
                    <span class="biome-stat-label">Humidité</span>
                    <span class="biome-stat-value">@Model.Model.Humidity g/m³</span>
                </div>
            </div>
        </a>

        @if (Model.CanEdit)
        {
            <a class="biome-row-actions biome-row-edit" asp-page="/Biomes/Edit" asp-route-slug="@Model.Model.Slug">Modifier
                →</a>
        }
    </div>
</div>