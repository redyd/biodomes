@model BioDomes.Domains.Core.Species

<div class="species-card">
    <div class="species-name">@Model.Name</div>

    <div class="species-info">
        <span class="species-label">Type :</span> @Model.Type
    </div>

    <div class="species-info">
        <span class="species-label">Régime :</span> @Model.Diet
    </div>

    <div class="species-info">
        <span class="species-label">Taille adulte :</span> @Model.Height
    </div>
    
    <a asp-page="/SpeciesPages/Edit"
       asp-route-slug="@Model.Name.ToKebabCase()">
        Editer
    </a>

</div>