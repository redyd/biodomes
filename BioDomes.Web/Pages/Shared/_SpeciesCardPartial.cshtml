@model BioDomes.Web.ViewModels.SpecieView

<div class="species-card">
    @if (Model.ImageUrl != null)
    {
        <div>
            <img src="@Model.ImageUrl" alt="@Model.Name" class="species-card-image"/>
        </div>
    }
    else
    {
        <div class="species-card-image-placeholder"></div>
    }
    <div class="species-card-body">
        <div class="species-name">@Model.Name</div>
        <div class="species-info"><span class="species-label">Type :</span> @Model.Type</div>
        <div class="species-info"><span class="species-label">Régime :</span> @Model.Diet</div>
        <div class="species-info"><span class="species-label">Taille :</span> @Model.Height</div>
        <div class="species-info"><span class="species-label">Poids :</span> @Model.Weight</div>
        <a asp-page="/Species/Edit" asp-route-slug="@Model.Slug">Éditer</a>
    </div>
</div>
