@model BioDomes.Web.ViewModels.SpecieView

<div class="card">
    @if (Model.ImageUrl != null)
    {
        <div>
            <img src="@Model.ImageUrl" alt="@Model.Name" class="card-image"/>
        </div>
    }
    else
    {
        <div class="card-image-placeholder"></div>
    }
    <div class="card-body">
        <div class="card-name">@Model.Name</div>
        <div class="card-info"><span class="card-label">Type :</span> @Model.Type</div>
        <div class="card-info"><span class="card-label">Régime :</span> @Model.Diet</div>
        <div class="card-info"><span class="card-label">Taille :</span> @Model.Height</div>
        <div class="card-info"><span class="card-label">Poids :</span> @Model.Weight</div>
        @if (@Model.IsConnected)
        {
            <a asp-page="/Species/Edit" asp-route-slug="@Model.Slug">Éditer</a>
        }
    </div>
</div>
