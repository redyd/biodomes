@page
@model IndexModel
@{ ViewData["Title"] = "Accueil"; }

<div class="home-hero">
    <div class="hero-corner hero-corner--tl"></div>
    <div class="hero-corner hero-corner--br"></div>

    <p class="hero-label">Laudot Solutions présente</p>

    <h1 class="hero-title">
        Bienvenue dans<br>le <span>Dôme</span>
    </h1>

    <p class="hero-desc">
        Catalogue scientifique des espèces du Terrarium Zéro.<br>
        Consultez, analysez et gérez les données biologiques.
    </p>
    
    <div class="hero-stats">
        @foreach (var dome in Model.RankedBiomes)
        {
            <a asp-page="/Biomes/Detail" asp-route-slug="@dome.Model.Slug">
                <div class="hero-stat">
                    <div>
                        <img src="@dome.ImageUrl" alt="@dome.Model.Name" class="card-image"/>
                    </div>
                    <span class="hero-stat-value">@dome.Model.Name</span>
                    <span class="hero-stat-label">@dome.Model.SpeciesVariety variétées</span>
                </div>
            </a>
        }
    </div>

    <a class="hero-cta" asp-page="/Species/Index">
        Explorer les espèces
    </a>
</div>