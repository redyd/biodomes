@page
@model IndexModel
@{ ViewData["Title"] = "Accueil"; }

<div class="home-hero">
    <div class="hero-corner hero-corner--tl"></div>
    <div class="hero-corner hero-corner--br"></div>

    <p class="hero-label">Laudot Solutions présente</p>

    <h1 class="hero-title">
        Bienvenue dans<br>le <span>Dôme</span>
    </h1>

    <p class="hero-desc">
        Catalogue scientifique des espèces du Terrarium Zéro.<br>
        Consultez, analysez et gérez les données biologiques.
    </p>

    <div class="hero-stats">
        <div class="hero-stat">
            <span class="hero-stat-value">@Model.SpeciesCount</span>
            <span class="hero-stat-label">Espèces</span>
        </div>
        <div class="hero-stat">
            <span class="hero-stat-value">?</span>
            <span class="hero-stat-label">Dômes</span>
        </div>
        <div class="hero-stat">
            <span class="hero-stat-value">@Model.EquipmentCount</span>
            <span class="hero-stat-label">Equipements</span>
        </div>
    </div>

    <a class="hero-cta" asp-page="/Species/Index">
        Explorer les espèces
    </a>
</div>