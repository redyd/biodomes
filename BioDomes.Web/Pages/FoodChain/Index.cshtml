@page "/food-chain"
@using BioDomes.Web.Extensions
@model BioDomes.Web.Pages.FoodChain.Index

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Chaine alimentaire";
}

<div class="container-fluid vh-100 p-0">
    <div class="d-flex h-100">

        <div class="flex-grow-1 h-100">
            <div id="cy" class="h-100 w-100"></div>
        </div>

        @if (User.IsAdmin())
        {
            <aside class="sidebar-info border-start p-4"
                   style="width: 360px; background: var(--surface); overflow-y: auto;">
                <!-- En-tête de l'espèce -->
                <div class="mb-5">
                    <span class="text-uppercase tracking-widest text-muted small fw-bold"
                          style="letter-spacing: 0.1em; font-family: var(--mono);">Détails de l'espèce</span>
                    <h2 class="text-bright mt-2 mb-1" id="title" style="font-family: var(--sans); font-weight: 700;">
                        Aucune sélection</h2>
                    <div id="diet-badge" class="badge-diet d-inline-block px-2 py-1 small rounded"
                         style="background: var(--teal-dim); color: var(--teal); border: 1px solid var(--border-bright);">
                        <span id="diet" style="font-family: var(--mono);">---</span>
                    </div>
                </div>

                <!-- Section Proies Actuelles -->
                <section class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div
                            style="width: 8px; height: 8px; background: var(--teal); border-radius: 50%; margin-right: 10px; box-shadow: 0 0 8px var(--teal);"></div>
                        <h6 class="text-bright m-0" id="existing-title" style="font-family: var(--sans);">Chaîne
                            établie</h6>
                    </div>
                    <ul id="existing" class="list-unstyled d-flex flex-column gap-2">
                        <!-- Les items injectés ici -->
                    </ul>
                </section>

                <!-- Section Suggestions -->
                <section>
                    <div class="d-flex align-items-center mb-3">
                        <div
                            style="width: 8px; height: 8px; background: var(--amber); border-radius: 50%; margin-right: 10px; box-shadow: 0 0 8px var(--amber);"></div>
                        <h6 class="text-bright m-0" id="available-title" style="font-family: var(--sans);">Interactions
                            potentielles</h6>
                    </div>
                    <ul id="available" class="list-unstyled d-flex flex-column gap-2">
                        <!-- Les items injectés ici -->
                    </ul>
                </section>
            </aside>
        }

    </div>
</div>

<script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>

<script>
    window.foodChainData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Graph));
</script>

<script src="~/js/food-chain.js"></script>