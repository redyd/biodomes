@page "/food-chain"
@using BioDomes.Web.Extensions
@model BioDomes.Web.Pages.FoodChain.Index

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Chaine alimentaire";
}

<div class="p-0 d-block" id="title-section">
    <div class="d-flex layout-columns">

        <div class="flex-grow-1 mt-3 position-relative">
            <button id="cy-recenter" class="position-absolute btn-add bg-transparent border-0 mx-3 ">
                Recentre le graphe
            </button>
            <div id="cy"></div>
        </div>

        @if (User.IsAdmin())
        {
            <aside class="sidebar-info p-4">
                <div class="mb-5">
                    <span class="text-uppercase text-muted small fw-bold">Détails de l'espèce</span>
                    <h2 class="text-bright mt-2 mb-1" id="title" style="">
                        Aucune sélection</h2>
                    <div id="diet-badge" class="biome-state biome-state-optimal d-inline-block">
                        <span id="diet">---</span>
                    </div>
                </div>

                <section class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="point point-primary"></div>
                        <h6 class="text-bright m-0" id="existing-title">Proies actuelles</h6>
                    </div>
                    <ul id="existing" class="list-unstyled d-flex flex-column gap-2">
                    </ul>
                </section>

                <section>
                    <div class="d-flex align-items-center mb-3">
                        <div class="point point-secondary"></div>
                        <h6 class="text-bright m-0" id="available-title">Suggestions de proies</h6>
                    </div>
                    <ul id="available" class="list-unstyled d-flex flex-column gap-2">
                    </ul>
                </section>
            </aside>
        }

    </div>
</div>


<script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>

<script>
    window.foodChainData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Graph));
    window.isAdmin =  @Html.Raw(User.IsAdmin() ? 1 : 0);
</script>

<script src="~/js/food-chain.js"></script>
