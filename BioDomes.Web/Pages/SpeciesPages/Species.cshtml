@page "/species"
@model SpeciesModel

@{
    Layout = "Shared/_Layout";
}

<div class="species-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-banner" id="success-banner">
            L'espèce <strong>@TempData["SuccessMessage"]</strong> a été modifiée avec succès.
        </div>
    }
    
    <div class="species-title">
        <h1>Espèces</h1>
        <p>Liste des espèces disponibles dans le biodôme</p>
        <a class="btn-save" asp-page="/SpeciesPages/Add">
            Ajouter une nouvelle espece !
        </a>
    </div>

    <div class="cards-grid">
        @foreach (var species in Model.SpeciesList)
        {
            <partial name="_SpeciesCardPartial" model="species"/>
        }
    </div>
</div>

@section Scripts {
    <script>
        const banner = document.getElementById('success-banner');
        if (banner) {
            setTimeout(() => {
                banner.style.transition = 'opacity 0.6s ease';
                banner.style.opacity = '0';
                setTimeout(() => banner.remove(), 600);
            }, 3000);
        }
    </script>
}
