@page "/species"
@model SpeciesModel

@{
    Layout = "Shared/_Layout";
}

<div class="species-container">
    <div class="species-title">
        <h1>Espèces</h1>
        <p>Liste des espèces disponibles dans le biodôme</p>
        <a asp-page="/SpeciesPages/Add">
            Ajouter une nouvelle espece !
        </a>
    </div>

    <div class="cards-grid">
        @foreach (var species in Model.SpeciesList)
        {
            <partial name="_SpeciesCardPartial" model="species"/>
        }
    </div>
</div>
