@page "/account"
@model BioDomes.Web.Pages.Account.Index

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Account";
}

<div class="edit-page">
    <div class="edit-card">
        <div class="edit-header">
            <p class="edit-breadcrumb">BioDomes · Mon compte</p>
            <h1 class="edit-title">Mon <em>profil</em></h1>
        </div>
        <div class="edit-body">
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                <div class="field-group">
                    <label asp-for="Input.Email" class="field-label">Email</label>
                    <input asp-for="Input.Email" class="field-input" placeholder="name@example.com"/>
                    <span asp-validation-for="Input.Email" class="field-error"></span>
                </div>
                
                <div class="field-group">
                    <label asp-for="Input.Name" class="field-label">Nom d'utilisateur</label>
                    <input asp-for="Input.Name" class="field-input"/>
                    <span asp-validation-for="Input.Name" class="field-error"></span>
                </div>

                <div class="edit-divider"></div>

                <div class="field-group">
                    <label asp-for="Input.Birthdate" class="field-label">Date de naissance</label>
                    <input asp-for="Input.Birthdate" class="field-input" type="date"/>
                    <span asp-validation-for="Input.Birthdate" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Input.SearchOrganism" class="field-label">Organisme de recherche</label>
                    <input asp-for="Input.SearchOrganism" class="field-input" placeholder="ex: Axolotl"/>
                    <span asp-validation-for="Input.SearchOrganism" class="field-error"></span>
                </div>

                <div class="field-group">
                    <span class="image-current-label">Image actuelle</span>
                    <img src="@Model.CurrentImageUrl" class="card-image" alt="profile"/>
                    <label class="image-upload-hint">Changer l'image</label>
                    <div class="image-upload-zone">
                        <input type="file" asp-for="Input.ImageUpload" accept="image/*"/>
                    </div>
                    <span asp-validation-for="Input.ImageUpload" class="field-error"></span>
                </div>

                <div class="edit-divider"></div>

                <div class="field-group">
                    <label asp-for="Input.CurrentPassword" class="field-label">Mot de passe actuel</label>
                    <input asp-for="Input.CurrentPassword" class="field-input" type="password" placeholder="••••••••"/>
                    <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Input.NewPassword" class="field-label">Nouveau mot de passe</label>
                    <input asp-for="Input.NewPassword" class="field-input" type="password" placeholder="••••••••"/>
                    <span asp-validation-for="Input.NewPassword" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Input.ConfirmPassword" class="field-label">Confirmer le mot de passe</label>
                    <input asp-for="Input.ConfirmPassword" class="field-input" type="password" placeholder="••••••••"/>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
                </div>

                <div class="edit-divider"></div>

                <div class="edit-actions">
                    <a asp-page="/Index" class="btn-cancel">Annuler</a>
                    <button type="submit" class="btn-save">Sauvegarder</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
