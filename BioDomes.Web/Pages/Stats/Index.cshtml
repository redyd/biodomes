@page "/stats"
@model BioDomes.Web.Pages.Stats.StatsModel

@{
Layout = "Shared/_Layout";
ViewData["Title"] = "Statistiques";
}

<div class="main-container">
    <div class="container-title">
        <h1>Statistiques</h1>
        <p>Vue d'ensemble de vos biomes</p>
    </div>

    @if (!Model.HasBiomes)
    {
    <div id="empty-state" class="stats-empty">
        <p class="stats-empty-title">Aucune donnée disponible</p>
        <p class="stats-empty-desc">Créez des biomes pour obtenir des statistiques.</p>
        <a class="btn-save" asp-page="/Biomes/Add">Créer un biome</a>
    </div>
    }
    else
    {
    <div class="stats-controls">
        <span class="field-label">Biome</span>
        <select class="field-input stats-select" id="biomeSelector">
            <option value="all">Tous mes biomes</option>
        </select>
    </div>

    <div class="stats-tabs">
        <button class="stats-tab active" data-pane="species">Espèces</button>
        <button class="stats-tab" data-pane="history">Évolution</button>
        <button class="stats-tab" data-pane="conditions">Conditions</button>
        <button class="stats-tab" data-pane="trophic">Réseau trophique</button>
    </div>

    <div id="pane-species" class="stats-pane active">
        <div class="stats-metrics">
            <div class="stat-metric">
                <div class="stat-metric-label">Total biomes</div>
                <div class="stat-metric-value" id="m-biomes">—</div>
            </div>
            <div class="stat-metric">
                <div class="stat-metric-label">Total espèces</div>
                <div class="stat-metric-value" id="m-species">—</div>
            </div>
            <div class="stat-metric">
                <div class="stat-metric-label">Moy. espèces / biome</div>
                <div class="stat-metric-value" id="m-avg">—</div>
            </div>
        </div>
        <div class="chart-card">
            <div class="chart-card-header">
                <div class="chart-card-title">Nombre d'espèces par biome</div>
                <button class="btn-export" onclick="exportChart('cSpecies','leg-species','especes-par-biome')">Exporter</button>
            </div>
            <div class="chart-legend" id="leg-species"></div>
            <div class="chart-wrap" style="height:280px">
                <canvas id="cSpecies"></canvas>
            </div>
        </div>
    </div>

    <div id="pane-history" class="stats-pane">
        <div class="stats-controls" style="margin-bottom:1rem">
            <span class="field-label">Période</span>
            <div class="period-btns">
                <button class="period-btn" data-days="7">7 jours</button>
                <button class="period-btn active" data-days="30">30 jours</button>
                <button class="period-btn" data-days="90">90 jours</button>
                <button class="period-btn" data-days="0">Tout</button>
            </div>
        </div>
        <div id="history-empty">
            Aucune donnée sur cette période.<br>
            <button class="period-btn" style="margin-top:1rem" onclick="document.querySelector('[data-days=\'0\']').click()">Afficher tout</button>
        </div>
        <div class="chart-card">
            <div class="chart-card-header">
                <div class="chart-card-title">Évolution du nombre d'espèces</div>
                <button class="btn-export" onclick="exportChart('cHistory','leg-history','evolution-especes')">Exporter</button>
            </div>
            <div class="chart-legend" id="leg-history"></div>
            <div class="chart-wrap" style="height:280px"><canvas id="cHistory"></canvas></div>
        </div>
        <div class="chart-card" style="margin-top:1rem">
            <div class="chart-card-header">
                <div class="chart-card-title">Espèces par régime alimentaire</div>
                <button class="btn-export" onclick="exportChart('cDietHistory','leg-diet-history','evolution-regime-alimentaire')">Exporter</button>
            </div>
            <div class="chart-legend" id="leg-diet-history"></div>
            <div class="chart-wrap" style="height:260px"><canvas id="cDietHistory"></canvas></div>
        </div>
        <div class="chart-card" style="margin-top:1rem">
            <div class="chart-card-header">
                <div class="chart-card-title">Espèces par classification</div>
                <button class="btn-export" onclick="exportChart('cClassHistory','leg-class-history','evolution-classification')">Exporter</button>
            </div>
            <div class="chart-legend" id="leg-class-history"></div>
            <div class="chart-wrap" style="height:260px"><canvas id="cClassHistory"></canvas></div>
        </div>
    </div>

    <div id="pane-conditions" class="stats-pane">
        <div class="chart-card">
            <div class="chart-card-header">
                <div class="chart-card-title">Température par biome (°C)</div>
                <button class="btn-export" onclick="exportChart('cTemp',null,'temperature-par-biome')">Exporter</button>
            </div>
            <div class="chart-wrap" style="height:260px"><canvas id="cTemp"></canvas></div>
        </div>
        <div class="chart-card">
            <div class="chart-card-header">
                <div class="chart-card-title">Humidité par biome (g/m³)</div>
                <button class="btn-export" onclick="exportChart('cHum',null,'humidite-par-biome')">Exporter</button>
            </div>
            <div class="chart-wrap" style="height:260px"><canvas id="cHum"></canvas></div>
        </div>
    </div>

    <div id="pane-trophic" class="stats-pane">
        <div class="chart-two-col">
            <div class="chart-card">
                <div class="chart-card-header">
                    <div class="chart-card-title">Par régime alimentaire</div>
                    <button class="btn-export" onclick="exportChart('cDiet','leg-diet','regime-alimentaire')">Exporter</button>
                </div>
                <div class="chart-legend" id="leg-diet"></div>
                <div class="chart-wrap" style="height:240px"><canvas id="cDiet"></canvas></div>
            </div>
            <div class="chart-card">
                <div class="chart-card-header">
                    <div class="chart-card-title">Par classification</div>
                    <button class="btn-export" onclick="exportChart('cClass','leg-class','classification')">Exporter</button>
                </div>
                <div class="chart-legend" id="leg-class"></div>
                <div class="chart-wrap" style="height:240px"><canvas id="cClass"></canvas></div>
            </div>
        </div>
    </div>
    }

    <div id="detail-modal" class="detail-modal">
        <div class="detail-box">
            <div class="detail-header">
                <span id="detail-title"></span>
                <button id="detail-close">x</button>
            </div>
            <div id="detail-body"></div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
<script src="js/stats.js"></script>
