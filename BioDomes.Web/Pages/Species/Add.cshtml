@page "/species/add"
@model AddModel

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Ajouter une espèce";
}

<div class="edit-page">
    <div class="edit-card">

        <div class="edit-header">
            <p class="edit-breadcrumb">Biodômes · Espèces</p>
            <h1 class="add-title">Ajouter une espece : </h1>
        </div>

        <div class="edit-body">
            <form method="post" enctype="multipart/form-data">
                <div class="field-group">
                    <label class="field-label">Nom</label>
                    <input class="field-input" type="text" asp-for="Input.Name"/>
                    <span asp-validation-for="Input.Name" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label class="field-label" asp-for="Input.Type">Classification</label>
                    <select class="field-input" asp-for="Input.Type">
                        <option value="">-- Choisir --</option>
                        @foreach (var classification in Enum.GetNames<BioDomes.Domains.Core.SpeciesClassification>())
                        {
                            <option value="@classification">@classification</option>
                        }
                    </select>
                    <span asp-validation-for="Input.Type" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label class="field-label">Régime</label>
                    <input class="field-input" type="text" asp-for="Input.Diet"/>
                    <span asp-validation-for="Input.Diet" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label class="field-label">Taille adulte (cm)</label>
                    <input class="field-input" type="number" asp-for="Input.Height"/>
                    <span asp-validation-for="Input.Height" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label class="field-label">Poids adulte (g)</label>
                    <input class="field-input" type="number" asp-for="Input.Weight"/>
                    <span asp-validation-for="Input.Weight" class="field-error"></span>
                </div>
                
                <div class="field-group">
                    @if (Model.Specie?.ImageUrl != null)
                    {
                        <span class="image-current-label">Image actuelle</span>
                        <img src="@Model.Specie.ImageUrl" class="species-image" alt="@Model.Specie.Name"/>
                    }
                    <label class="image-upload-hint">
                        @(Model.Specie?.ImageUrl != null ? "Changer l'image" : "Ajouter une image")
                    </label>
                    <div class="image-upload-zone">
                        <input type="file" asp-for="Input.Image" accept="image/*"/>
                    </div>
                    <span asp-validation-for="Input.Image" class="field-error"></span>
                </div>

                <div class="edit-divider"></div>

                <div class="edit-actions">
                    <a class="btn-cancel" asp-page="/Species/Species">Annuler</a>
                    <button class="btn-save" type="submit">Sauvegarder</button>
                </div>
            </form>
        </div>

    </div>
</div>
