@page "/species/edit/{slug:kebab}"
@model BioDomes.Web.Pages.Species.EditModel
@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Modifier une espèce";
}

<div class="edit-page">
    <div class="edit-card">

        <div class="edit-header">
            <p class="edit-breadcrumb">Biodômes · Espèces</p>
            <h1 class="edit-title">Éditer : <em>@Model.Specie?.Name</em></h1>
        </div>

        <div class="edit-body">
            <form method="post" enctype="multipart/form-data">
                <div class="field-group">
                    <label class="field-label">Nom</label>
                    <input class="field-input" type="text" asp-for="Input.Name"/>
                    <span asp-validation-for="Input.Name" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label class="field-label" asp-for="Input.ClassificationId">Classification</label>
                    <select class="field-input" asp-for="Input.ClassificationId">
                        <option value="">-- Choisir --</option>
                        @foreach (var classification in Model.Classifications)
                        {
                            <option value="@classification.Id">@classification.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Input.ClassificationId" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label class="field-label" asp-for="Input.DietId">Régime</label>
                    <select class="field-input" asp-for="Input.DietId">
                        <option value="">-- Choisir --</option>
                        @foreach (var diet in Model.Diets)
                        {
                            <option value="@diet.Id">@diet.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Input.DietId" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label class="field-label">Taille adulte (cm)</label>
                    <input class="field-input" type="number" asp-for="Input.Height"/>
                    <span asp-validation-for="Input.Height" class="field-error"></span>
                </div>
                <div class="field-group">
                    <label class="field-label">Poids adulte (g)</label>
                    <input class="field-input" type="number" asp-for="Input.Weight"/>
                    <span asp-validation-for="Input.Weight" class="field-error"></span>
                </div>

                <div class="field-group">
                    <span class="image-current-label">Image actuelle</span>
                    <img src="@Model.ImageUrl" class="card-image" alt="@Model?.Specie?.Name"/>
                    <label class="image-upload-hint">Changer l'image</label>
                    <div class="image-upload-zone">
                        <input type="file" asp-for="Input.Image" accept="image/*"/>
                    </div>
                    <span asp-validation-for="Input.Image" class="field-error"></span>
                </div>

                @if (Model is not null && Model.IsAdmin)
                {
                    <div class="field-group">
                        <label class="field-label" for="checkbox-input">Changer la visibilité</label>
                        <div class="d-flex align-middle gap-3">
                            <p class="m-0">Visible</p>
                            <input type="checkbox" asp-for="Input.Public" id="checkbox-input"/>
                        </div>
                    </div>
                }

                <div class="edit-divider"></div>

                <div class="edit-actions">
                    <a class="btn-cancel" asp-page="/Species/Index">Annuler</a>
                    <button class="btn-save" type="submit" name="action" value="delete">Supprimer</button>
                    <button class="btn-save" type="submit" name="action" value="save">Sauvegarder</button>
                </div>
            </form>
        </div>

    </div>
</div>