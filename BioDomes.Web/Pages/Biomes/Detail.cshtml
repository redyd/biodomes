@page "/biomes/{id:int}"
@using System.Text.Json
@using BioDomes.Web.Extensions
@model Detail

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = Model.Biome.Model.Name;
}

<div class="container">
    <div class="main-container">
        <section>
            <div class="container-title">
                <div class="d-flex justify-content-center align-items-center gap-3 flex-row">
                    <h1 id="top">@Model.Biome.Model.Name</h1>
                    <span class="biome-state biome-state-@Model.Biome.Model.State.GetDisplayName().ToLower()">
                        @Model.Biome.Model.State
                    </span>
                </div>
                <p>Créé par "@Model.Creator"</p>
                @if (Model.Biome.CanEdit)
                {
                    <a class="btn-save" asp-page="/Biomes/Edit" asp-route-id="@Model.Biome.Model.Id">Modifier les
                        informations</a>
                }
            </div>
            <img class="img-header" src="@Model.Biome.ImageUrl" alt="@Model.Biome.Model.Name"/>
        </section>
    </div>
</div>

<hr class="mb-0"/>

<div class="p-0 d-block" id="title-section">
    <div class="d-flex layout-columns">

        <partial name="Shared/Sidebar/_EnvironmentSidebar" model="Model"/>

        <div class="flex-grow-1 mt-3 position-relative">
            <button id="cy-recenter" class="position-absolute btn-add bg-transparent border-0 mx-3">
                Recentre le graphe
            </button>
            <a href="#top" class="position-absolute btn-add bg-transparent border-0 mx-3 end-0">Remonter</a>
            <div class="container-title mb-0">
                <a href="#title-section" class="large-title">Détail</a>
                <hr class="mb-0"/>
            </div>
            <div id="cy"></div>
        </div>

        <partial name="Shared/Sidebar/_BiomeSidebar" model="Model"/>

    </div>
</div>

<partial name="Shared/Dialog/_AddSpecieDialog" model="Model"/>
<partial name="Shared/Dialog/_RemoveSpecieDialog" model="Model"/>

<partial name="Shared/Dialog/_AddEquipmentDialog" model="Model"/>
<partial name="Shared/Dialog/_RemoveEquipmentDialog" model="Model"/>

<div id="node-popper" class="node-tooltip" style="display:none; position:absolute; z-index:1000;">
    <div class="tooltip-content">
        <strong id="tooltip-name"></strong>
        <p id="tooltip-status" class="m-0"></p>
    </div>
</div>

<script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>

<script>
    window.data = @Html.Raw(JsonSerializer.Serialize(Model.Analyze));
</script>

<script src="~/js/biome-detail.js"></script>