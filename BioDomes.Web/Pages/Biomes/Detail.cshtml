@page "/biomes/{id:int}"
@using BioDomes.Domains.Core
@model Detail

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = Model.Biome.Name;
}

<div class="container">
    <div class="main-container">
        <section>
            <div class="container-title">
                <div class="d-flex justify-content-center align-items-center gap-3 flex-row">
                    <h1 id="top">@Model.Biome.Name</h1>
                    <span class="biome-state biome-state-@Model.Biome.State.ToLower()">
                        @Model.Biome.State
                    </span>
                </div>
                <p>Créé par "@Model.Creator"</p>
                @if (Model.Biome.CanEdit)
                {
                    <a class="btn-save" asp-page="/Biomes/Edit" asp-route-id="@Model.Biome.Id">Modifier les
                        informations</a>
                }
            </div>
            <img class="img-header" src="@Model.Biome.ImageUrl" alt="@Model.Biome.Name"/>
        </section>
    </div>
</div>
<hr class="mb-0"/>
<div class="p-0 d-block" id="title-section">
    <div class="d-flex layout-columns">
        @* info *@
        <aside class="sidebar-info p-4">
            <div class="mb-5">
                <span class="text-uppercase text-muted small fw-bold"
                      style="">Informations</span>
                <h2 class="text-bright mt-2 mb-1" id="title">Paramètres & état</h2>
            </div>

            <section class="mb-5">
                <div class="d-flex align-items-center mb-3">
                    <div class="point point-primary"></div>
                    <h6 class="text-bright m-0" id="existing-title">Conditions environnementales</h6>
                </div>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li class="li-info-card">
                        <div class="d-flex flex-column">
                            <span>@Model.Biome.Temperature °C</span>
                            <span class="specie-meta">Température actuelle</span>
                        </div>
                    </li>
                    <li class="li-info-card">
                        <div class="d-flex flex-column">
                            <span>@Model.Biome.Humidity g/m³</span>
                            <span class="specie-meta">Humidité actuelle</span>
                        </div>
                    </li>
                    <li class="li-info-card">
                        <div class="d-flex flex-column">
                            <span>@Model.Biome.MaxHumidity.ToString("0.##") g/m³</span>
                            <span class="specie-meta">Humidité maximum</span>
                        </div>
                    </li>
                    <li>
                        <div class="d-flex justify-content-between mb-1 mt-2">
                            <span class="specie-meta">Saturation d'humidité</span>
                            <span class="specie-meta">@Model.Biome.HumidityPercent.ToString("0")%</span>
                        </div>
                        <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                            <div class="progress-bar bg-primary"
                                 role="progressbar"
                                 style="width: @Model.Biome.HumidityPercent.ToString("0")%"
                                 aria-valuenow="@Model.Biome.HumidityPercent"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </li>
                </ul>
            </section>

            <section>
                <div class="d-flex align-items-center mb-3">
                    <div class="point point-secondary"></div>
                    <h6 class="text-bright m-0" id="available-title">Diagnostiques</h6>
                </div>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li class="li-info-card">
                        <div class="d-flex flex-column">
                            <span>@Model.Biome.State</span>
                            <span class="specie-meta">État thermique</span>
                        </div>
                    </li>
                    <li class="li-info-card">
                        <div class="d-flex flex-column">
                            <span>xxx</span>
                            <span class="specie-meta">État trophique</span>
                        </div>
                    </li>
                </ul>
            </section>

            @if (Model.Biome.CanEdit)
            {
                <section>
                    <div class="d-flex align-items-center mb-3">
                        <div class="point point-primary"></div>
                        <h6 class="text-bright m-0" id="available-title">Suggestions</h6>
                    </div>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        @foreach (var rec in Model.Recommendations)
                        {
                            <li class="li-info-card">
                                <div class="d-flex flex-column">
                                    <span>@rec.Message</span>
                                    <span class="specie-meta">@rec.Label</span>
                                </div>
                                <form method="post" asp-page-handler="ExecuteAction">
                                    <input type="hidden" name="actionId" value="@rec.ActionId"/>
                                    <input type="hidden" name="biomeId" value="@Model.Biome.Id"/>
                                    <button type="submit" class="btn-action btn-add p-1">✓</button>
                                </form>
                                <button class="btn-action btn-remove p-1 btn-suggestion-del" data-id="@rec.ActionId"
                                        title="Ignorer la suggestion"> ×
                                </button>
                            </li>
                        }
                    </ul>
                </section>
            }
        </aside>

        @* graph *@
        <div class="flex-grow-1 mt-3 position-relative">
            <button id="cy-recenter" class="position-absolute btn-add bg-transparent border-0 mx-3">
                Recentre le graphe
            </button>
            <a href="#top" class="position-absolute btn-add bg-transparent border-0 mx-3 end-0">Remonter</a>
            <div class="container-title mb-0">
                <a href="#title-section" class="large-title">Détail</a>
                <hr class="mb-0"/>
            </div>
            <div id="cy"></div>
        </div>

        @* gestion *@
        <aside class="sidebar-info p-4">
            <div class="mb-5">
                <span class="text-uppercase text-muted small fw-bold">Gestions</span>
                <h2 class="text-bright mt-2 mb-1" id="title">Espèces & équipements</h2>
            </div>

            <section class="mb-5">
                <div class="d-flex align-items-center mb-3">
                    <div class="point point-primary"></div>
                    <h6 class="text-bright m-0" id="existing-title">Les espèces</h6>
                </div>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    @if (Model.FoodChain.Nodes.Count > 0)
                    {
                        <li class="li-info-card">
                            <div class="d-flex flex-column">
                                <span>Ajouter une espèce</span>
                            </div>
                            <button
                                class="btn-action btn-add"
                                title="Ajouter une nouvelle espèce"
                                onclick="document.getElementById('add-species-dialog').showModal()">
                                +
                            </button>
                        </li>
                    }
                    @foreach (var specie in Model.FoodChain.Nodes)
                    {
                        <li class="li-info-card">
                            <div class="d-flex flex-column">
                                <span>@specie.Name</span>
                                <span class="specie-meta">@specie.Classification.Label</span>
                            </div>
                            <button
                                class="btn-action btn-remove"
                                title="Supprimer des @specie.Name"
                                onclick="document.getElementById('remove-species-dialog').showModal()">
                                ×
                            </button>
                        </li>
                    }
                    @if (Model.FoodChain.Nodes.Count == 0)
                    {
                        <li class="li-info-card">
                            <div class="d-flex flex-column">
                                <span>Commencez à ajouter des espèces</span>
                                <span class="specie-meta">Aucune espèce</span>
                            </div>
                            <button
                                class="btn-action btn-add"
                                title="Ajouter votre première espèce"
                                onclick="document.getElementById('add-species-dialog').showModal()">
                                +
                            </button>
                        </li>
                    }
                </ul>
            </section>

            <section>
                <div class="d-flex align-items-center mb-3">
                    <div class="point point-secondary"></div>
                    <h6 class="text-bright m-0" id="available-title">Les équipements</h6>
                </div>
                <ul class="list-unstyled d-flex flex-column gap-2">
                </ul>
            </section>
        </aside>

    </div>
</div>

<partial name="Shared/Modals/_AddSpecieDialog" model="species"/>

<dialog id="remove-species-dialog">
    <div class="large-edit-card">
        <div class="edit-header">
            <p class="edit-breadcrumb">Biodômes · @Model.Biome.Name</p>
            <h1 class="edit-title">Retirer une espèce</h1>
        </div>

        <form method="post" asp-page-handler="RemoveSpecie" class="edit-body">

            <div class="field-group">
                @foreach (var group in Model
                                  .Recommendations
                                  .GroupBy(r => r.Type)
                                  .OrderBy(g => g.Key))
                {
                    <p class="suggestion-group-label">@group.Key</p>
                    <div class="suggestion-group">
                        @foreach (var specie in group.Select(r => r.Involved))
                        {
                            <label class="suggestion-card">
                                <input type="radio" asp-for="Input.SpecieId" value="@specie.Id" hidden/>
                                @if (!string.IsNullOrWhiteSpace(specie.ImageUrl))
                                {
                                    <img class="suggestion-card-img" src="@Model.UseUploadedFromId(specie.ImageUrl)"
                                         alt="@specie.Name"/>
                                }
                                <span class="suggestion-name">@specie.Name</span>
                            </label>
                        }
                    </div>
                }

                <span asp-validation-for="Input.SpecieId" class="field-error"></span>
            </div>

            <div class="field-group">
                <label class="field-label">Quantité</label>
                <input class="field-input" type="number" step="1" asp-for="Input.Count"/>
                <span asp-validation-for="Input.Count" class="field-error"></span>
            </div>

            <div class="edit-divider"></div>

            <div class="edit-actions">
                <button type="button" class="btn-cancel"
                        onclick="document.getElementById('remove-species-dialog').close()">
                    Annuler
                </button>
                <button class="btn-save" type="submit" name="action" value="save">Ajouter</button>
            </div>
        </form>
    </div>
</dialog>

<script src="https://unpkg.com/cytoscape/dist/cytoscape.min.js"></script>

<script>
    window.foodChainData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FoodChain));
</script>

<script src="~/js/biome-detail.js"></script>