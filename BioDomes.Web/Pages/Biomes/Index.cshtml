@page "/biomes"
@using BioDomes.Web.Extensions
@model BiomePage

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Biomes";
}

<div class="container">
    <div class="main-container">
        <div class="container-title">
            <h1>Biomes</h1>
            <p>Les différents biomes</p>
            @if (Model.IsUserConnected)
            {
                <a class="btn-save" asp-page="/Biomes/Add">
                    Ajouter un nouveau biome
                </a>
            }
        </div>

        @if (Model.IsUserConnected)
        {
            <div class="search-bar-wrap">
                <span class="search-icon">⌕</span>
                <input
                    id="biome-search"
                    class="search-input"
                    type="text"
                    placeholder="Rechercher par nom, espèce, équipement, température..."
                    autocomplete="off"/>
            </div>

            <div id="search-results" style="display:none">
                <p class="search-results-count" id="search-count"></p>
                <div id="search-list"></div>
            </div>
        }

        <div class="biomes-list">
            @if (Model.Biomes.Any())
            {
                @foreach (var biome in Model.Biomes)
                {
                    <div class="biome-row">
                        <div class="biome-row-image">
                            @if (!string.IsNullOrEmpty(biome.ImageUrl))
                            {
                                <img src="@biome.ImageUrl" alt="@biome.Model.Name"/>
                            }
                            else
                            {
                                <div class="biome-row-image-placeholder"></div>
                            }
                            <span
                                class="biome-state biome-state-badge biome-state-@biome.Model.State.GetDisplayName().ToLower()">@biome.Model.State</span>
                        </div>

                        <a class="biome-row-body" asp-page="/Biomes/Detail" asp-route-id="@biome.Model.Id">
                            <div class="biome-row-header">
                                <h2 class="biome-row-name">@biome.Model.Name</h2>
                                @if (biome.IsPublic)
                                {
                                    <span class="biome-badge-public">public</span>
                                }
                            </div>

                            <div class="biome-row-stats">
                                <div class="biome-stat">
                                    <span class="biome-stat-label">Température</span>
                                    <span class="biome-stat-value">@biome.Model.Temperature °C</span>
                                </div>
                                <div class="biome-stat">
                                    <span class="biome-stat-label">Humidité</span>
                                    <span class="biome-stat-value">@biome.Model.Humidity g/m³</span>
                                </div>
                            </div>
                        </a>

                        @if (biome.CanEdit)
                        {
                            <a class="biome-row-actions biome-row-edit"
                               asp-page="/Biomes/Edit"
                               asp-route-id="@biome.Model.Id">
                                Modifier →
                            </a>
                        }
                    </div>
                }
            }
            else
            {
                <p class="biomes-empty">Aucun biome disponible.</p>
            }
        </div>
    </div>
</div>

@if (Model.IsUserConnected)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>
        <script>
            const rawData = @Html.Raw(Model.BiomesJson);

            const fuse = new Fuse(rawData, {
                keys: [
                    {name: 'name', weight: 0.35},
                    {name: 'species', weight: 0.3},
                    {name: 'equipments', weight: 0.3},
                    {name: 'temperature', weight: 0.025},
                    {name: 'humidity', weight: 0.025},
                ],
                threshold: 0.3,
                minMatchCharLength: 1,
                includeScore: true,
            });

            const input = document.getElementById('biome-search');
            const wrap = document.getElementById('search-results');
            const list = document.getElementById('search-list');
            const count = document.getElementById('search-count');
            const biomesL = document.querySelector('.biomes-list');

            input.addEventListener('input', () => {
                const q = input.value.trim();

                if (!q) {
                    wrap.style.display = 'none';
                    biomesL.style.display = '';
                    return;
                }

                const results = fuse.search(q).map(r => r.item);

                biomesL.style.display = 'none';
                wrap.style.display = 'block';
                count.textContent = `${results.length} résultat(s) pour "${q}"`;
                list.innerHTML = results.length
                    ? results.map(card).join('')
                    : '<p class="biomes-empty">Aucun biome trouvé.</p>';
            });

            function card(b) {
                const species = (b.species || []).map(s => `<span class="search-tag species">${s}</span>`).join('');
                const equipments = (b.equipments || []).map(e => `<span class="search-tag equipment">${e}</span>`).join('');

                return `
                <a class="search-result-card" href="/Biomes/Detail?id=${b.id}">
                    <div class="search-result-name">
                        ${b.name}
                        ${b.isPublic ? '<span class="biome-badge-public">public</span>' : ''}
                    </div>
                    <div class="search-result-meta">
                        <span>${b.temperature} °C</span>
                        <span>${b.humidity} g/m³</span>
                        <span>${b.state}</span>
                    </div>
                    <div class="search-result-tags">${species}${equipments}</div>
                </a>`;
            }
        </script>
    }
}
