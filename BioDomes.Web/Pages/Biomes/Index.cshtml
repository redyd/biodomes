@page "/biomes"
@model BiomePage

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Biomes";
}

<div class="container">
    <div class="main-container">
        <div class="container-title">
            <h1>Biomes</h1>
            <p>Les différents biomes</p>
            @if (Model.IsUserConnected)
            {
                <a class="btn-save" asp-page="/Biomes/Add">Ajouter un nouveau biome</a>
            }
        </div>

        @if (Model.IsUserConnected)
        {
            <div class="search-bar-wrap">
                <span class="search-icon">⌕</span>
                <input id="biome-search" class="search-input" type="text"
                       placeholder="Rechercher par nom, espèce, équipement, température..." autocomplete="off"/>
            </div>
            <p id="search-count" style="display:none" class="search-results-count"></p>

        }
        
        @if (Model.BalancedBiomes.Any())
        {
            <div class="card-body">
                <h2 class="card-name">Biomes en équilibre</h2>

                <div class="biomes-list">
                    @foreach (var biome in Model.BalancedBiomes)
                    {
                        <partial name="Shared/_BiomeRow" model="biome.Key" />
                    }
                </div>
            </div>
        }

        @if (Model.OtherBiomes.Any())
        {
            <div class="card-body">

                <h2 class="card-name">
                    @(Model.BalancedBiomes.Any() ? "Autres biomes" : "Tous les biomes")
                </h2>

                <div class="biomes-list">
                    @foreach (var biome in Model.OtherBiomes)
                    {
                        <partial name="Shared/_BiomeRow" model="biome.Key" />
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card-body">
                <h2 class="card-name">Tous les biomes</h2>
                <p class="biomes-empty">Aucun biome disponible.</p>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>

<script>
    const rawData = @Html.Raw(Model.BiomesJson);
</script>

<script src="js/biome-search.js"></script>  