@page "/biomes/edit/{slug:kebab}"
@using BioDomes.Web.Extensions
@model BioDomes.Web.Pages.Biomes.EditPage

@{
    Layout = "Shared/_Layout";
    ViewData["Title"] = "Modifier un biome";
}

<div class="edit-page">
    <div class="edit-card">

        <div class="edit-header">
            <p class="edit-breadcrumb">Biodômes · Biomes</p>
            <h1 class="edit-title">Éditer : <em>@Model.BiomeName.Sanitize()</em></h1>
        </div>

        <div class="edit-body">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Slug"/>

                <div class="field-group">
                    <label class="field-label">Nom</label>
                    <input class="field-input" type="text" asp-for="Input.Name"/>
                    <span asp-validation-for="Input.Name" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label class="field-label">Température (°C)</label>
                    <input class="field-input" type="number" step="0.1" asp-for="Input.Temperature"/>
                    <span asp-validation-for="Input.Temperature" class="field-error"></span>
                </div>

                <div class="field-group">
                    <label class="field-label">Humidité absolue (g/m³)</label>
                    <input class="field-input" type="number" step="0.01" asp-for="Input.AbsoluteHumidity"/>
                    <span asp-validation-for="Input.AbsoluteHumidity" class="field-error"></span>
                </div>

                <div class="field-group">
                    <span class="image-current-label">Image actuelle</span>
                    <img src="@Model.CurrentImageUrl" class="card-image" alt="@Model.BiomeName"/>
                    <label class="image-upload-hint">Changer l'image</label>
                    <div class="image-upload-zone">
                        <input type="file" asp-for="Input.Image" accept="image/*"/>
                    </div>
                    <span asp-validation-for="Input.Image" class="field-error"></span>
                </div>

                <div class="edit-divider"></div>

                <div class="edit-actions">
                    <a class="btn-cancel" asp-page="/Biomes/Index">Annuler</a>
                    <button class="btn-save" type="submit" name="action" value="delete">Supprimer</button>
                    <button class="btn-save" type="submit" name="action" value="save">Sauvegarder</button>
                </div>
            </form>
        </div>

    </div>
</div>